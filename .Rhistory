# ==============================================================================
# Projet : FSEC Data Pipeline - Food Security & MEAL Analytics
# Fichier : R/01_import_data.R
# Auteur : Héritier Mwenza Bwira
# Description : Importation des données brutes KoboToolbox et vérification des structures
# ==============================================================================
# 1. Chargement des packages nécessaires
if (!require("pacman")) install.packages("pacman")
pacman::p_load(tidyverse, janitor, readxl)
message("--> Début de l'étape 01 : Importation des données...")
# 2. Définition des chemins de fichiers
raw_data_path <- "data/raw/fsec_simulated_raw.csv"
output_rds_path <- "data/processed/01_imported_data.rds"
# 3. Vérification de l'existence du fichier brut
if (!file.exists(raw_data_path)) {
warning("ATTENTION : Le fichier 'fsec_simulated_raw.csv' n'a pas encore été placé dans 'data/raw/'.")
warning("Un jeu de données de démonstration temporaire va être généré pour tester le pipeline.")
# Génération d'une structure minimale de test si le CSV n'existe pas encore
set.seed(123)
df_dummy <- tibble(
hh_id = paste0("HH_", 1001:1015),
interview_date = Sys.Date() - sample(1:10, 15, replace = TRUE),
enumerator_id = sample(c("ENV_001", "ENV_002", "ENV_003"), 15, replace = TRUE),
cluster_zone = sample(c("cluster_1", "cluster_2", "cluster_3"), 15, replace = TRUE),
respondent_sex = sample(c("female", "male"), 15, replace = TRUE),
respondent_age = sample(18:65, 15, replace = TRUE),
hh_size = sample(3:10, 15, replace = TRUE),
children_u5 = sample(0:3, 15, replace = TRUE),
fcs_cereals = sample(0:7, 15, replace = TRUE),
fcs_pulses = sample(0:7, 15, replace = TRUE),
fcs_vegetables = sample(0:7, 15, replace = TRUE),
fcs_fruits = sample(0:7, 15, replace = TRUE),
fcs_meat_fish = sample(0:7, 15, replace = TRUE),
fcs_dairy = sample(0:7, 15, replace = TRUE),
fcs_sugar = sample(0:7, 15, replace = TRUE),
fcs_oil = sample(0:7, 15, replace = TRUE),
rcsi_less_preferred = sample(0:7, 15, replace = TRUE),
rcsi_borrow_food = sample(0:7, 15, replace = TRUE),
rcsi_limit_portion = sample(0:7, 15, replace = TRUE),
rcsi_reduce_adults = sample(0:7, 15, replace = TRUE),
rcsi_reduce_meals = sample(0:7, 15, replace = TRUE),
hdds_cereals = sample(c("yes", "no"), 15, replace = TRUE),
hdds_roots = sample(c("yes", "no"), 15, replace = TRUE),
hdds_vegetables = sample(c("yes", "no"), 15, replace = TRUE),
hdds_fruits = sample(c("yes", "no"), 15, replace = TRUE),
hdds_meat = sample(c("yes", "no"), 15, replace = TRUE),
hdds_eggs = sample(c("yes", "no"), 15, replace = TRUE),
hdds_fish = sample(c("yes", "no"), 15, replace = TRUE),
hdds_legumes_nuts = sample(c("yes", "no"), 15, replace = TRUE),
hdds_milk = sample(c("yes", "no"), 15, replace = TRUE),
hdds_oils = sample(c("yes", "no"), 15, replace = TRUE),
hdds_sweets = sample(c("yes", "no"), 15, replace = TRUE),
hdds_spices = sample(c("yes", "no"), 15, replace = TRUE),
hhs_no_food_occ = sample(c("yes", "no"), 15, replace = TRUE),
hhs_no_food_freq = sample(c("rarely", "sometimes", "often"), 15, replace = TRUE),
hhs_sleep_hungry_occ = sample(c("yes", "no"), 15, replace = TRUE),
hhs_sleep_hungry_freq = sample(c("rarely", "sometimes", "often"), 15, replace = TRUE),
hhs_whole_day_occ = sample(c("yes", "no"), 15, replace = TRUE),
hhs_whole_day_freq = sample(c("rarely", "sometimes", "often"), 15, replace = TRUE)
)
dir.create("data/raw", showWarnings = FALSE, recursive = TRUE)
write_csv(df_dummy, raw_data_path)
message("--> Un jeu de données de démonstration a été créé automatiquement dans 'data/raw/fsec_simulated_raw.csv'.")
}
# 4. Importation réelle et nettoyage des noms de colonnes
raw_data <- read_csv(raw_data_path, show_col_types = FALSE) %>%
clean_names()
# 5. Sauvegarde du fichier RDS intermédiaire
dir.create("data/processed", showWarnings = FALSE, recursive = TRUE)
saveRDS(raw_data, output_rds_path)
message(paste0("--> Étape 01 terminée avec succès ! ", nrow(raw_data), " lignes importées et sauvegardées."))
```
# ==============================================================================
# Projet : FSEC Data Pipeline - Food Security & MEAL Analytics
# Fichier : R/02_clean_data.R
# Auteur : Héritier Mwenza Bwira
# Description : Nettoyage, typage et standardisation des données brutes
# ==============================================================================
# 1. Chargement des packages
if (!require("pacman")) install.packages("pacman")
pacman::p_load(tidyverse, janitor)
message("--> Début de l'étape 02 : Nettoyage et standardisation des données...")
# 2. Chargement des données issues de l'étape 01
input_path <- "data/processed/01_imported_data.rds"
output_path <- "data/processed/02_cleaned_data.rds"
if (!file.exists(input_path)) {
stop("ERREUR : Le fichier de l'étape 01 est introuvable. Veuillez exécuter '01_import_data.R' d'abord.")
}
raw_data <- readRDS(input_path)
# 3. Traitement et nettoyage
clean_data <- raw_data %>%
# Nettoyage global des chaînes de caractères (suppression des espaces superflus)
mutate(across(where(is.character), str_trim)) %>%
# Conversion et sécurisation des types de variables numériques
mutate(
respondent_age = as.numeric(respondent_age),
hh_size = as.numeric(hh_size),
children_u5 = as.numeric(children_u5),
# Sécurisation des scores FCS (0 à 7)
across(starts_with("fcs_"), ~ as.numeric(.)),
# Sécurisation des scores rCSI (0 à 7)
across(starts_with("rcsi_"), ~ as.numeric(.))
) %>%
# Remplacement des éventuelles valeurs négatives accidentelles par NA (sécurité)
mutate(
respondent_age = ifelse(respondent_age < 0, NA, respondent_age),
hh_size = ifelse(hh_size < 0, NA, hh_size)
)
# 4. Sauvegarde des données nettoyées
saveRDS(clean_data, output_path)
message(paste0("--> Étape 02 terminée avec succès ! ", nrow(clean_data <- clean_data), " lignes nettoyées et prêtes pour le DQA."))
# ---
# ==============================================================================
# Projet : FSEC Data Pipeline - Food Security & MEAL Analytics
# Fichier : R/03_validate_dqa.R
# Auteur : Héritier Mwenza Bwira
# Description : Moteur DQA (Data Quality Assessment) et détection d'anomalies
# ==============================================================================
# 1. Chargement des packages
if (!require("pacman")) install.packages("pacman")
pacman::p_load(tidyverse, janitor)
message("--> Début de l'étape 03 : Exécution du moteur DQA...")
# 2. Chargement des données nettoyées
input_path <- "data/processed/02_cleaned_data.rds"
output_report_path <- "outputs/reports/dqa_anomaly_report.csv"
if (!file.exists(input_path)) {
stop("ERREUR : Le fichier de l'étape 02 est introuvable. Veuillez exécuter '02_clean_data.R' d'abord.")
}
data <- readRDS(input_path)
# 3. Contrôles de qualité (DQA Rules)
anomalies_list <- list()
# Règle A : Détection des doublons d'identifiants ménages (hh_id)
duplicates_hh <- data %>%
get_dupes(hh_id) %>%
mutate(anomaly_type = "Doublon d'identifiant ménage (hh_id)")
if (nrow(duplicates_hh) > 0) {
anomalies_list$duplicates <- duplicates_hh %>% select(hh_id, anomaly_type)
}
# Règle B : Incohérence démographique (enfants U5 > taille du ménage)
invalid_children <- data %>%
filter(children_u5 > hh_size) %>%
mutate(anomaly_type = "Incohérence : Enfants de moins de 5 ans > Taille du ménage")
if (nrow(invalid_children) > 0) {
anomalies_list$children <- invalid_children %>% select(hh_id, anomaly_type)
}
# Règle C : Valeurs aberrantes sur l'âge du répondant (< 18 ou > 120 ans)
invalid_age <- data %>%
filter(respondent_age < 18 | respondent_age > 120) %>%
mutate(anomaly_type = "Valeur aberrante : Âge du répondant hors normes (18-120)")
if (nrow(invalid_age) > 0) {
anomalies_list$age <- invalid_age %>% select(hh_id, anomaly_type)
}
# Règle D : Scores FCS hors limites (en dehors de 0 à 7 jours)
invalid_fcs <- data %>%
filter(across(starts_with("fcs_"), ~ . < 0 | . > 7) %>% rowSums() > 0) %>%
mutate(anomaly_type = "Valeur aberrante : Score FCS hors intervalle [0-7]")
if (nrow(invalid_fcs) > 0) {
anomalies_list$fcs <- invalid_fcs %>% select(hh_id, anomaly_type)
}
# 4. Compilation et export du rapport d'anomalies
dir.create("outputs/reports", showWarnings = FALSE, recursive = TRUE)
if (length(anomalies_list) > 0) {
dqa_report <- bind_rows(anomalies_list)
write_csv(dqa_report, output_report_path)
message(sprintf("--> DQA terminé : %d anomalie(s) détectée(s) et consignées dans '%s'.", nrow(dqa_report), output_report_path))
} else {
# Création d'un rapport vide mais structuré si aucune anomalie n'est trouvée
dqa_report <- tibble(hh_id = character(), anomaly_type = character())
write_csv(dqa_report, output_report_path)
message("--> DQA terminé avec succès : Aucune anomalie critique détectée dans le jeu de données !")
}
# ---
# ==============================================================================
# Projet : FSEC Data Pipeline - Food Security & MEAL Analytics
# Fichier : R/04_calculate_indicators.R
# Auteur : Héritier Mwenza Bwira
# Description : Calcul des indicateurs standardisés FSL (FCS, rCSI, HDDS, HHS)
# ==============================================================================
# 1. Chargement des packages
if (!require("pacman")) install.packages("pacman")
pacman::p_load(tidyverse, janitor)
message("--> Début de l'étape 04 : Calcul des indicateurs FSL...")
# 2. Chargement des données nettoyées
input_path <- "data/processed/02_cleaned_data.rds"
output_path <- "data/processed/04_indicators_data.rds"
if (!file.exists(input_path)) {
stop("ERREUR : Le fichier de l'étape 02 est introuvable. Veuillez exécuter '02_clean_data.R' d'abord.")
}
data <- readRDS(input_path)
# 3. Calcul des Indicateurs FSL
indicators_data <- data %>%
mutate(
# A. Calcul du Food Consumption Score (FCS) avec pondérations standard PAM
# Pondérations : Céréales(2), Légumineuses(3), Légumes(1), Fruits(1), Viande/Poisson(4), Lait(4), Sucre(0.5), Huile(0.5)
fcs_score = (fcs_cereals * 2) +
(fcs_pulses * 3) +
(fcs_vegetables * 1) +
(fcs_fruits * 1) +
(fcs_meat_fish * 4) +
(fcs_dairy * 4) +
(fcs_sugar * 0.5) +
(fcs_oil * 0.5),
# Catégories FCS standard PAM (Seuils : 0-21 = Pauvre, 21.5-35 = Limite, >35 = Acceptable)
fcs_cat = case_when(
fcs_score <= 21   ~ "Pauvre (Poor)",
fcs_score <= 35   ~ "Limite (Borderline)",
fcs_score > 35    ~ "Acceptable",
TRUE              ~ "Inconnu"
),
# B. Calcul du Reduced Coping Strategies Index (rCSI) avec pondérations standard
# Moins préférés(1), Emprunter nourriture(2), Limiter portions(1), Réduire adultes pour enfants(3), Réduire nombre de repas(1)
rcsi_score = (rcsi_less_preferred * 1) +
(rcsi_borrow_food * 2) +
(rcsi_limit_portion * 1) +
(rcsi_reduce_adults * 3) +
(rcsi_reduce_meals * 1),
# C. Calcul du Household Dietary Diversity Score (HDDS) (Somme des 'yes' sur 12 groupes)
hdds_score = (hdds_cereals == "yes") + (hdds_roots == "yes") +
(hdds_vegetables == "yes") + (hdds_fruits == "yes") +
(hdds_meat == "yes") + (hdds_eggs == "yes") +
(hdds_fish == "yes") + (hdds_legumes_nuts == "yes") +
(hdds_milk == "yes") + (hdds_oils == "yes") +
(hdds_sweets == "yes") + (hdds_spices == "yes")
)
# 4. Sauvegarde des données avec indicateurs calculés
dir.create("data/processed", showWarnings = FALSE, recursive = TRUE)
saveRDS(indicators_data, output_path)
message(paste0("--> Étape 04 terminée avec succès ! Indicateurs FSL calculés pour ", nrow(indicators_data), " ménages."))
# ---
# ==============================================================================
# Projet : FSEC Data Pipeline - Food Security & MEAL Analytics
# Fichier : R/05_analyze_data.R
# Auteur : Héritier Mwenza Bwira
# Description : Analyses descriptives et agrégations des indicateurs FSL par zone
# ==============================================================================
# 1. Chargement des packages
if (!require("pacman")) install.packages("pacman")
pacman::p_load(tidyverse, janitor, knitr)
message("--> Début de l'étape 05 : Analyses statistiques et agrégations...")
# 2. Chargement des données avec indicateurs
input_path <- "data/processed/04_indicators_data.rds"
output_summary_path <- "outputs/reports/fsl_summary_stats.csv"
if (!file.exists(input_path)) {
stop("ERREUR : Le fichier de l'étape 04 est introuvable. Veuillez exécuter '04_calculate_indicators.R' d'abord.")
}
data <- readRDS(input_path)
# 3. Agrégations statistiques par zone d'enquête (cluster_zone)
fsl_summary_by_zone <- data %>%
group_by(cluster_zone) %>%
summarise(
total_households = n(),
mean_hh_size = round(mean(hh_size, na.rm = TRUE), 1),
mean_fcs = round(mean(fcs_score, na.rm = TRUE), 1),
mean_rcsi = round(mean(rcsi_score, na.rm = TRUE), 1),
mean_hdds = round(mean(hdds_score, na.rm = TRUE), 1),
pct_poor_fcs = round(mean(fcs_cat == "Pauvre (Poor)", na.rm = TRUE) * 100, 1),
.groups = "drop"
)
# Affichage du résumé dans la console RStudio
print(fsl_summary_by_zone)
# 4. Sauvegarde du tableau de synthèse
dir.create("outputs/reports", showWarnings = FALSE, recursive = TRUE)
write_csv(fsl_summary_by_zone, output_summary_path)
message(paste0("--> Étape 05 terminée avec succès ! Tableau de synthèse exporté dans '", output_summary_path, "'."))
# ---
# ==============================================================================
# Projet : FSEC Data Pipeline - Food Security & MEAL Analytics
# Fichier : R/06_export_results.R
# Auteur : Héritier Mwenza Bwira
# Description : Exportation finale du dataset maître consolidé pour reporting
# ==============================================================================
# 1. Chargement des packages
if (!require("pacman")) install.packages("pacman")
pacman::p_load(tidyverse, janitor)
message("--> Début de l'étape 06 : Exportation finale du dataset maître...")
# 2. Chargement des données avec indicateurs
input_path <- "data/processed/04_indicators_data.rds"
output_master_csv <- "outputs/fsec_master_dataset.csv"
output_master_rds <- "data/processed/fsec_master_dataset.rds"
if (!file.exists(input_path)) {
stop("ERREUR : Le fichier de l'étape 04 est introuvable. Veuillez exécuter '04_calculate_indicators.R' d'abord.")
}
master_data <- readRDS(input_path)
# 3. Sélection et réarrangement final des colonnes clés pour le portfolio
final_export <- master_data %>%
select(
hh_id, interview_date, enumerator_id, cluster_zone,
respondent_sex, respondent_age, hh_size, children_u5,
fcs_score, fcs_cat, rcsi_score, hdds_score
)
# 4. Sauvegarde aux formats CSV et RDS finaux
dir.create("outputs", showWarnings = FALSE, recursive = TRUE)
dir.create("data/processed", showWarnings = FALSE, recursive = TRUE)
write_csv(final_export, output_master_csv)
saveRDS(final_export, output_master_rds)
message(paste0("--> Pipeline 100% R exécuté de bout en bout avec succès ! Dataset maître exporté dans : '", output_master_csv, "'."))
# ---
# ==============================================================================
q()
